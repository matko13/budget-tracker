# Dodaj do secrets.yaml w Home Assistant
# ========================================
#
# Numer telefonu w formacie międzynarodowym (bez + i spacji)
# np. dla Polski: 48XXXXXXXXX
whatsapp_phone: "48XXXXXXXXX"
whatsapp_apikey: "TWÓJ_API_KEY_Z_CALLMEBOT"

# Webhook do Next.js app (opcjonalne - do zaawansowanego proxy)
budget_app_webhook_url: "https://twoja-domena.vercel.app/api/home-assistant/webhook"
budget_app_webhook_secret: "LOSOWY_SECRET_32_ZNAKI"
